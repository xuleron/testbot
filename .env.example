# ========== 禅道配置 ==========
# 禅道服务地址（不带末尾斜杠）。
ZENTAO_URL=https://zentao.example.com
# 禅道子路径（如部署在 /zentao 下则填 zentao，默认留空）。
ZENTAO_BASE_PATH=

# 禅道登录账号（用于同步用例/回写结果/提 Bug）。
ZENTAO_ACCOUNT=admin
# 禅道登录密码。
ZENTAO_PASSWORD=your_password

# 禅道认证模式：auto=自动判断，session=网页会话，rest=REST API。
ZENTAO_AUTH_MODE=auto

# 禅道项目 ID（用于上下文与关联）。
ZENTAO_PROJECT_ID=20
# 禅道产品 ID（12.x 下建议显式配置）。
ZENTAO_PRODUCT_ID=20
# 禅道迭代/执行 ID（没有可填 0）。
ZENTAO_EXECUTION_ID=0
# 默认用例模块 ID（0 表示按逻辑自动分配/创建）。
ZENTAO_MODULE_ID=0

# 是否自动创建禅道用例模块。
ZENTAO_AUTO_CREATE_MODULES=true
# 测试失败时是否自动提 Bug。
ZENTAO_AUTO_CREATE_BUGS=true
# 自动提 Bug 的类型（如 codeerror、config、install 等）。
ZENTAO_BUG_TYPE=codeerror
# Bug 严重程度（1-4，1最高）。
ZENTAO_BUG_SEVERITY=3
# Bug 优先级（1-4，1最高）。
ZENTAO_BUG_PRI=3
# Bug 影响版本/构建（常用 trunk）。
ZENTAO_OPENED_BUILD=trunk
# 是否对 blocked 结果也自动提 Bug。
ZENTAO_BUG_ON_BLOCKED=false

# 回写结果时关联的测试单 ID（无则 0）。
ZENTAO_TESTTASK_ID=0

# 禅道应用集成 code（12.x 通常留空）。
ZENTAO_APP_CODE=
# 禅道应用集成 secret（12.x 通常留空）。
ZENTAO_APP_SECRET=

# ========== 被测 OA 应用（Playwright 浏览器登录）==========
# 被测系统入口地址（可填首页或登录页）。
TARGET_APP_URL=http://your-oa-app.example.com
# 被测系统登录页地址（留空则使用 TARGET_APP_URL）。
TARGET_APP_LOGIN_URL=
# 被测系统登录用户名（不是禅道账号）。
TARGET_APP_USERNAME=your_oa_username
# 被测系统登录密码（不是禅道密码）。
TARGET_APP_PASSWORD=your_oa_password

# ========== 被测项目源码 ==========
# 被测项目源码根目录。
TARGET_PROJECT_PATH=../your-project

# ========== 测试执行 ==========
# 执行模式：playwright=真实浏览器；llm=静态判定；auto=混合；framework=仅跑现有自动化。
EXECUTOR_MODE=playwright
# LLM/执行分批大小（每批处理多少条用例）。
LLM_EXEC_BATCH_SIZE=10
# 最大执行用例数（0=不限制，建议先小规模试跑）。
LLM_EXEC_MAX_CASES=0

# ========== Playwright 浏览器 ==========
# 是否无头运行浏览器（true=不显示窗口，false=显示窗口）。
BROWSER_HEADLESS=false
# 单步默认超时时间（毫秒）。
BROWSER_TIMEOUT_MS=30000
# 浏览器慢动作延时（毫秒，调试时可设 100~500）。
BROWSER_SLOW_MO=0
# 浏览器视口宽度。
BROWSER_VIEWPORT_WIDTH=1280
# 浏览器视口高度。
BROWSER_VIEWPORT_HEIGHT=720
# 用户名输入框选择器（留空=自动探测）。
BROWSER_USERNAME_SELECTOR=
# 密码输入框选择器（留空=自动探测）。
BROWSER_PASSWORD_SELECTOR=
# 登录按钮选择器（留空=自动探测）。
BROWSER_SUBMIT_SELECTOR=

# ========== TestBot 行为 ==========
# 报告输出目录。
REPORT_OUTPUT_DIR=.reports
# 默认用例优先级（1-4）。
DEFAULT_CASE_PRIORITY=3
# 默认用例类型（feature/interface/unit/config/install/performance/security/other）。
DEFAULT_CASE_TYPE=feature

# ========== LLM 配置 ==========
# LLM 服务商（openai/deepseek/ollama）。
LLM_PROVIDER=deepseek
# LLM API 地址。
LLM_API_BASE=https://api.deepseek.com/v1
# LLM API Key。
LLM_API_KEY=sk-your-deepseek-api-key
# LLM 模型名称。
LLM_MODEL=deepseek-chat

# 用例规划模式：llm=常规生成，full=全功能点覆盖。
PLANNER_MODE=full
# 是否启用 LLM 项目分析增强。
USE_LLM_ANALYZE=true

# LLM 随机性温度（越低越稳定）。
LLM_TEMPERATURE=0.2
# 单次 LLM 最大输出 token。
LLM_MAX_TOKENS=8192
# LLM 请求超时（秒）。
LLM_TIMEOUT=120
# 单次上下文最大文件数。
LLM_CONTEXT_MAX_FILES=30
# 单次上下文最大字符数。
LLM_CONTEXT_MAX_CHARS=80000

# 常规模式最少生成用例数。
LLM_MIN_CASES=5
# 常规模式最多生成用例数。
LLM_MAX_CASES=20

# ========== full 模式（全覆盖）专用 ==========
# 每个功能点至少生成几条用例。
LLM_CASES_PER_FEATURE=3
# 每批处理功能点数量。
LLM_FEATURE_BATCH_SIZE=5
# 功能盘点阶段最多扫描文件数。
LLM_INVENTORY_MAX_FILES=100
# 功能盘点阶段最多上下文字符数。
LLM_INVENTORY_MAX_CHARS=150000
# 功能盘点分块文件数（防止 JSON 过长）。
LLM_INVENTORY_CHUNK_FILES=25
# 功能盘点阶段单次最大 token。
LLM_INVENTORY_MAX_TOKENS=8192
